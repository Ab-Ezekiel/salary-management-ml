import shap
import matplotlib.pyplot as plt
explainer = shap.TreeExplainer(rf_model)



shap_values = explainer.shap_values(X_test)


shap.summary_plot(
    shap_values,
    X_test,
    max_display=10,
    show=False
)

plt.gcf().set_size_inches(30, 6)
plt.show()


